# Stefan Berns · Vertriebs-Cockpit (Auswanderung Zypern)
# Lokal: als .env.local kopieren (oder `vercel env pull .env.local`). In Vercel als Environment Variables anlegen.

# --- Supabase (setzt die Vercel-Supabase-Integration automatisch) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Öffentliche Adresse (für Einladungs-Links), z. B. https://dashboard.stefanberns.com
NEXT_PUBLIC_SITE_URL=

# --- Close CRM ---
CLOSE_API_KEY=
# Erwartete Close-Org (Schutz: Setup bricht bei anderer Org ab). Stefans Org: OCEC Ltd
CLOSE_ORG_NAME=OCEC Ltd
# Ausgabe von `npm run close:webhook -- https://<domain>/api/webhooks/close`
CLOSE_WEBHOOK_SECRET=

# --- Calendly (Buchungen → Close + Dashboard) ---
# Nur für die Registrierung nötig (npm run calendly:webhook -- https://<domain>/api/webhooks/calendly)
CALENDLY_TOKEN=
# Ausgabe der Registrierung
CALENDLY_WEBHOOK_SIGNING_KEY=

# --- Stripe (Abrechnung) ---
# Secret Key (sk_live_… / sk_test_…) – Zahlungslinks erstellen, Zahlungen nachladen
STRIPE_SECRET_KEY=
# Ausgabe von `npm run stripe:webhook -- https://<domain>/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=
# 1 = Stripe legt zur bezahlten Zahlung einen Beleg (Rechnung, Status bezahlt) an. Standard: aus
STRIPE_BELEG=0
# optional, z. B. card,sepa_debit (leer = Stripe-Einstellung)
STRIPE_PAYMENT_METHODS=

# --- Meta Marketing API (System-User-Token, läuft nicht ab) ---
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_
META_API_VERSION=v23.0
# Conversions API (Rückspielung Close → Meta)
META_PIXEL_ID=
META_CAPI_TOKEN=

# --- Betrieb ---
# Zufälliger String; Vercel Cron sendet ihn als Authorization: Bearer …
CRON_SECRET=
# Slack Incoming Webhook für Briefings
SLACK_WEBHOOK_URL=

# --- Schalter (Standard: AUS) ---
# 1 = Ereignisse an Meta zurückspielen
CAPI_AKTIV=0
# 1 = Morgen-Briefing/Wochenreport wirklich an Slack senden (sonst nur Vorschau)
REPORTS_AKTIV=0
# 1 = immer Demo-Daten, 0 = nie Demo-Daten (auch wenn die DB leer ist), leer = Demo nur bei leerer DB
DEMO_DATEN=
